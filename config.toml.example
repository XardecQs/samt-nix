# GTA Mod Organizer — Configuration template
#
# Copy this file to `config.toml` (next to the binary, or in the repo root)
# and edit the paths. gta-mo looks for it in this order:
#   1. $GTA_MO_CONFIG
#   2. ./config.toml
#   3. $XDG_CONFIG_HOME/gta-mo/config.toml
#
# The database lives at $GTA_MO_DB or $XDG_DATA_HOME/gta-mo/organizer.db.

game_root = "/home/user/Games/GTA_SA"
proton_path = "/home/user/.steam/root/compatibilitytools.d/GE-Proton11-1"

# Optional settings (defaults shown):
# game = "gta_sa"                    # game profile (see crates/core/src/games.rs)
# game_id = "umu-gtasa"
# game_exe = "gta_sa.exe"
# proton_use_wined3d = true
# proton_disable_ntsync = false
# proton_disable_upscalers = false   # true = evitar que Proton (GE/CachyOS) descargue/actualice upscalers (FSR/DLSS/XeSS/OptiScaler)
# umu_runtime_update = false         # true = permitir que umu-launcher actualice su runtime steamrt4 al lanzar
# auto_discover = true
# default_profile = "vanilla"   # used by `launch` when --profile is not given
# dxvk_hud = "devinfo,fps,frametimes,submissions,compiler,version,api,pipelines,memory,gpuload,drawcalls"
# mods_dir = "/path/to/mods"    # defaults to game_root/mods
#
# Page-cache preloading before launch (speeds up startup on slow disks):
#   "off"    = do not preload
#   "prefix" = warm the Wine prefix, the game exe and the mods' startup files (default)
#   "full"   = also warm the whole base game and every enabled mod file (slow;
#              warns and asks for confirmation on an interactive terminal)
# preload = "prefix"
#
# Print per-phase launch timings (config/db, plan, mount, preload, time to window).
# timings = true
#
# Write Proton's verbose `steam-<appid>.log` on every launch (extra I/O; only
# enabled by default with `--debug`).
# proton_log = false
#
# Run the game against a tmpfs copy of the Wine prefix
# (`/dev/shm/gta-mo/pfx`), so a long game session cannot evict it from RAM; the
# on-disk prefix stays as the source of truth (rsync in before the launch and
# back after it, keeping the copy for the next launch). Requires no system
# changes; falls back to disk if /dev/shm is unavailable. Inspect it with
# `gta-mo prefix status` and free it with `gta-mo prefix clean`.
# prefix_ram = true
