# GTA Mod Organizer manifest
#
# Copy this file as `mod.toml` inside a mod folder under `mods/` and fill it in.
# All fields are optional; `mount` and `[dependencies]` are the only ones with
# functional impact. You can also generate it per-mod with: gta-mo ctl init <folder>

# id = "autor:slug"        # id estable (autor + nombre, ambos en minusculas)
# name = "Nombre visible"  # si falta, se usa el nombre de la carpeta
# version = "1.0.0"
# author = ["Autor"]       # string o lista
# url = "https://github.com/..."
# description = "Descripción del mod."
# license = "MIT"          # licencia/términos indicados por el autor (si los hay)
# tags = ["tag1", "tag2"]  # para organizar/filtrar

# Carátula y guías (rutas relativas dentro de esta carpeta)
# cover = "cover.png"
# guides = ["guides/instalacion.md"]

# Galería de imágenes extra en el panel de detalle: una carpeta (se expande a
# sus imágenes) o una lista de rutas.
# screenshots = ["screenshots"]

# Opciones seleccionables por perfil (una entrada con variantes/configs). El
# valor elegido monta options/<grupo>/<valor>/ ENCIMA de mount. Si no declaras
# [[options]], los grupos y valores se auto-descubren de options/<grupo>/<valor>/.
# [[options]]
# group = "variant"              # slug [a-z0-9_-]
# name = "Variante"              # etiqueta visible (opcional)
# default = "4k"                 # opcional; sin default, "sin opción" = solo mount
#   [[options.choices]]
#   key = "4k"
#   name = "4K"
#   [[options.choices]]
#   key = "lite"
#   conflicts = ["otro:mod"]       # restricción de la elección activa (opcional)
#   requires_any = ["otro:mod"]    # al menos uno (opcional)

# Subdirectorios cuyo CONTENIDO se monta sobre la raíz del juego.
# Cada entrada se trata como la raíz del juego: mount = ["content"] hace que
# content/d3d9.dll acabe en <raíz del juego>/d3d9.dll y content/models/* en
# <raíz>/models/*. Útil para mods con muchos archivos sueltos (mételos en una
# carpeta content/ y lista esa). Sin esta clave se monta la carpeta entera.
# mount = ["content"]

# Dependencias: referencias por id (autor:slug) o por nombre de carpeta.
# [dependencies]
# required = ["otro:mod"]  # sin esto el mod no funciona
# optional = []

# Variante de una familia mutuamente excluyente (4K/LITE, RoSA/vanilla…):
# solo una variante del mismo `group` puede estar activa a la vez.
# [variant]
# group = "proper-fixes"
# name = "RoSA"

# Mods incompatibles (por id o carpeta); no se pueden activar juntos.
# conflicts = ["otro:mod"]

# Al menos UNO de estos debe estar activo (alternativas). Solo se valida.
# requires_any = ["otro:mod-4k", "otro:mod-lite"]

# Prioridad en Mod Loader para las carpetas que este mod aporta a modloader/.
# El launcher la escribe en el modloader.ini del perfil al lanzar.
# [modloader]
# priority = 60            # 1..100 (mayor gana)
# folders = ["Proper Fixes"]  # opcional; se autodetecta modloader/<X>

# Si es un pack de mods, lista sus componentes (solo metadata).
# guides también acepta carpetas: guides = ["guides"] lista su contenido.
# [[components]]
# name = "Componente"
# version = "1.0.0"
# author = "Autor"
# url = "https://..."
# path = "content/carpeta-del-componente"
